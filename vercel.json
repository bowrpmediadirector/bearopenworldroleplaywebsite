{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "handle": "filesystem" },
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/admin$", "dest": "/admin.html" },
    { "src": "^/departments$", "dest": "/departments.html" },
    { "src": "^/staff$", "dest": "/staff.html" },
    { "src": "^/announcements$", "dest": "/announcements.html" },
    { "src": "^/events$", "dest": "/events.html" },
    { "src": "^/calendar$", "dest": "/calendar.html" },
    { "src": "^/guidelines$", "dest": "/guidelines.html" },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
