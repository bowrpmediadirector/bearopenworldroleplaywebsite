{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/departments", "destination": "/departments.html" },
    { "source": "/staff", "destination": "/staff.html" },
    { "source": "/announcements", "destination": "/announcements.html" },
    { "source": "/events", "destination": "/events.html" },
    { "source": "/calendar", "destination": "/calendar.html" },
    { "source": "/guidelines", "destination": "/guidelines.html" }
  ]
}
